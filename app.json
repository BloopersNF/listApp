{
  "expo": {
    "name": "MarketList",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9404218606533420~5307626712",
          "delayAppMeasurementInit": true
        }
      ],
      "expo-localization"
    ],
    "slug": "listApp",
    "version": "1.5.7",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/res/mipmap-xxxhdpi/ic_launcher.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A90E2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "9",
      "supportsTablet": true,
      "bundleIdentifier": "com.marketlist.app",
      "icon": "./assets/ios-icon.png"
    },
    "android": {
      "versionCode": 9,
      "package": "com.marketlist.app",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.marketlist.app",
      "icon": "./assets/res/mipmap-xxxhdpi/ic_launcher.png",
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "minSdkVersion": 24
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8bbecaaa-1800-4e32-8976-b5c84907f69c"
      }
    }
  }
}
